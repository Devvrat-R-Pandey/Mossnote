# Backend environment variables — copy to .env and fill in your values.
# NEVER commit .env to version control.

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://localhost:27017/mossnote

# Random secret for signing JWTs (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_secret

# Upstash Redis — get from https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# OpenRouter API key — get from https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Server port
PORT=5000

# Allowed frontend origin (comma-separated for multiple)
# Local dev:
CORS_ORIGIN=http://localhost:5173
# Production: CORS_ORIGIN=https://yourdomain.netlify.app

# Enable CLI admin scripts — only set this when running scripts locally, NEVER in production
# ADMIN_SCRIPTS_ENABLED=true
